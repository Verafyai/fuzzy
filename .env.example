# Shared Verafy credits (www.verafy.ai/api/credits). Same secret as the other
# product sites. Unset = a local mock ledger, labelled mocked in /api/verafy-credits/balance.
CREDITS_SERVICE_SECRET=
# CREDITS_API_URL=https://www.verafy.ai/api/credits

# Read-only RPC for ingest and mainnet history. The public endpoints rate-limit;
# use a paid RPC in production.
MAINNET_RPC_URL=
DEVNET_RPC_URL=

# Optional. Defaults to the three shared Verafy GA4 properties.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
